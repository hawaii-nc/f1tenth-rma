# Commit only curated checkpoints under checkpoints/final and checkpoints/archive.
checkpoint_epoch_*.pt
*.ckpt
# Generated by tools/prepare_tracks.py (racetrack DB is GPL-3.0; downloaded, not vendored)
maps/*_tight*
maps/racelines/
maps/spielberg*
maps/silverstone*
maps/monza*
maps/sochi*
maps/ims*
maps/zandvoort*
maps/sepang*
maps/yasmarina*
maps/budapest*
maps/melbourne*
